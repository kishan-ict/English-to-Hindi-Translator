# .env.example
# Copy this file to .env for local configuration if desired.
# Do NOT commit your actual .env file with secrets to Git.

# Optional: Email address used with MyMemory Translation API to increase daily quota from 1,000 words to 50,000 words/day (free)
TRANSLATION_API_EMAIL="student@college.edu"

# Optional: Custom API Key if using an authenticated translation provider
# TRANSLATION_API_KEY="your-api-key-here"

# Port for local Python HTTP server (default: 8000)
PORT=8000
